# =============================================================================
# Радар БПЛА — конфигурация для хостинга (Amvera)
# =============================================================================
# Скопируйте этот файл в .env и заполните значения.
# .env НЕ должен попадать в git — секреты задаются ТОЛЬКО через переменные
# окружения в панели Amvera.
# =============================================================================

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# ID целевого канала для публикации карт (обязательно)
# Формат: @username или -100xxxxxxxxxx (для приватных каналов)
# Бот должен быть администратором с правом публикации
CHAT_ID= @bpla_in_russia_online

# Канал-источник мониторинга (по умолчанию radarrussiia)
SOURCE_CHANNEL=radarrussiia

# Период опроса канала в секундах (по умолчанию 12)
POLL_SECONDS=12

# TTL угрозы в минутах — если угроза не подтверждается, она снимается
# (по умолчанию 180 = 3 часа)
TTL_MINUTES=180

# Отправлять карту как документ (1) или как фото (0)
# 0 = sendPhoto, 1 = sendDocument
SEND_AS_DOCUMENT=0

# =============================================================================
# Опциональные пути (на Amvera не нужны — используются значения по умолчанию)
# =============================================================================
# DATA_DIR=/data
# STATE_PATH=/data/state.json
# OUT_PATH=/data/map.png
# LOG_PATH=/data/bot.log
